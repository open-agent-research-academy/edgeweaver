{
  "model": "claude-fable-5-1",
  "effortLevel": "medium",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/ops/channel-notify-hook.mjs\" prompt",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/ops/channel-notify-hook.mjs\" notify",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/ops/channel-notify-hook.mjs\" clear",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "additionalDirectories": [
      "C:\\Users\\agent\\Project\\edgeweaver-soul",
      "C:\\Users\\agent\\Project\\edgeweaver-alpha-soul"
    ],
    "allow": [
      "Bash(*)",
      "Read(//c/Users/agent/Project/edgeweaver-soul/**)",
      "Read(//c/Users/agent/Project/edgeweaver-alpha-soul/**)",
      "Read(//c/Users/agent/.claude/channels/telegram/access.json)",
      "Read(//c/Users/agent/.claude/channels/telegram-genesis/access.json)",
      "Read(//c/Users/agent/.claude/channels/telegram-alpha/access.json)",
      "Read(//c/Users/agent/.claude/channels/telegram/inbox/**)",
      "Read(//c/Users/agent/.claude/channels/telegram-genesis/inbox/**)",
      "Read(//c/Users/agent/.claude/channels/telegram-alpha/inbox/**)",
      "mcp__plugin_telegram_telegram__download_attachment",
      "WebSearch",
      "WebFetch",
      "Edit(//c/Users/agent/Project/Edgeweaver/state/**)",
      "Edit(//c/Users/agent/Project/edgeweaver-alpha-soul/**)",
      "Write(//c/Users/agent/Project/edgeweaver-alpha-soul/**)",
      "Edit(//c/Users/agent/Project/edgeweaver-soul/**)",
      "Write(//c/Users/agent/Project/edgeweaver-soul/**)",
      "mcp__plugin_telegram_telegram__reply",
      "mcp__plugin_telegram_telegram__react",
      "mcp__plugin_telegram_telegram__edit_message"
    ]
  }
}
